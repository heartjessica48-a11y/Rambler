<Window x:Class="Rambler.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rambler Settings" Width="660" Height="660" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <!-- One settings row: a fixed-width label on the left, the control(s) on the right. -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="160" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="172,0,0,2" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IndentedCheck" TargetType="CheckBox">
            <Setter Property="Margin" Value="172,4,0,4" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <!-- ================= General ================= -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Dictation" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Default mode" />
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="240" HorizontalAlignment="Left"
                                      ToolTip="Prompt Cleanup rewrites your speech into clear text with a Gemini Flash model. Smart Only inserts Gemini's SMART transcript as is." />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Insert text" />
                            <ComboBox ItemsSource="{Binding InsertTimings}" SelectedItem="{Binding SelectedInsertTiming}" Width="240" HorizontalAlignment="Left"
                                      ToolTip="As I speak: finished phrases appear while you keep talking. When I finish: everything is inserted at the end (best whole-dictation coherence)." />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Insert into" />
                            <ComboBox ItemsSource="{Binding TargetModes}" SelectedItem="{Binding SelectedTargetMode}" Width="240" HorizontalAlignment="Left"
                                      ToolTip="Wherever I'm typing: text goes to the text field you're in when it's ready, even after switching apps. Only where I started: text waits until you return to the original field." />
                        </DockPanel>

                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Shortcut" ToolTip="Start/stop dictation in the default mode. Optional." />
                            <Button Content="Clear" Click="OnClearClick" Tag="{Binding ElementName=HotkeyToggleBox}" DockPanel.Dock="Right"
                                    Style="{StaticResource SmallButton}" ToolTip="Turn this shortcut off" />
                            <Button x:Name="RecordToggleButton" Content="Record" Click="OnRecordClick" Tag="{Binding ElementName=HotkeyToggleBox}"
                                    DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                    ToolTip="Click, then press the keys you want (Esc cancels, Backspace turns it off)" />
                            <TextBox x:Name="HotkeyToggleBox" Text="{Binding HotkeyToggle, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding ToggleStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToggleStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Rambler.Danger}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Smart Only shortcut"
                                       ToolTip="Start/stop a Smart Only dictation without changing your default mode. Optional." />
                            <Button Content="Clear" Click="OnClearClick" Tag="{Binding ElementName=HotkeyBypassBox}" DockPanel.Dock="Right"
                                    Style="{StaticResource SmallButton}" ToolTip="Turn this shortcut off" />
                            <Button x:Name="RecordBypassButton" Content="Record" Click="OnRecordClick" Tag="{Binding ElementName=HotkeyBypassBox}"
                                    DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                    ToolTip="Click, then press the keys you want (Esc cancels, Backspace turns it off)" />
                            <TextBox x:Name="HotkeyBypassBox" Text="{Binding HotkeyBypass, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding BypassStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BypassStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Rambler.Danger}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Typing" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Method" />
                            <ComboBox ItemsSource="{Binding InsertionMethods}" SelectedItem="{Binding SelectedInsertionMethod}"
                                      ToolTip="Line breaks never press a bare Enter (which sends messages in chat apps), except in classic editors like Notepad. Elsewhere multi-line text is pasted." />
                        </DockPanel>
                        <CheckBox Style="{StaticResource IndentedCheck}" Content="Restore my clipboard after pasting" IsChecked="{Binding RestoreClipboard}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="App" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Theme" />
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="240" HorizontalAlignment="Left"
                                      ToolTip="Follows Windows light/dark mode and your Windows accent color." />
                        </DockPanel>
                        <CheckBox Style="{StaticResource IndentedCheck}" Content="Play a sound when dictation starts and stops" IsChecked="{Binding PlaySounds}" />
                        <CheckBox Style="{StaticResource IndentedCheck}" Content="Start Rambler when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Audio ================= -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Microphone" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Device" />
                            <Button Content="Test" Command="{Binding TestMicrophoneCommand}" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                    ToolTip="Records about 4 seconds and plays it back. Nothing is saved or sent anywhere." />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      ToolTip="If this microphone is unplugged, Rambler uses the Windows default microphone." />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Input level" />
                            <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding MicLevel, Mode=OneWay}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding MicTestStatus}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Stopping" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Auto-stop" />
                            <CheckBox IsChecked="{Binding AutoStopOnSilence}" VerticalAlignment="Center"
                                      ToolTip="Thinking pauses never stop dictation. This optional stop only triggers after a long silence.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="After" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding SilenceTimeoutSeconds}" Width="56" Margin="8,0" />
                                    <TextBlock Text="seconds of silence" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Maximum length" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding MaxRecordingMinutes}" Width="56" />
                                <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Gemini ================= -->
            <TabItem Header="Gemini">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Account" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="API key"
                                       ToolTip="Create a key in Google AI Studio. Stored in Windows Credential Manager, never in plain text, never logged." />
                            <Button Content="Remove" Command="{Binding RemoveApiKeyCommand}" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                    ToolTip="Remove the saved key from Credential Manager" />
                            <Button Content="Test" Command="{Binding TestConnectionCommand}" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                    ToolTip="Checks the key, each model, and a live session setup. No audio is sent." />
                            <PasswordBox x:Name="ApiKeyBox" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ApiKeyStatus}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ConnectionStatus}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Transcription" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Live model" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding LiveModelSuggestions}" Text="{Binding LiveModel, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Recorded-audio model" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding RecordedModelSuggestions}" Text="{Binding RecordedModel, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <CheckBox Style="{StaticResource IndentedCheck}" Content="If live transcription fails, transcribe the recording instead"
                                  IsChecked="{Binding UseRecordedFallback}"
                                  ToolTip="Audio for the current dictation is kept in memory until it finishes, then cleared. Never written to disk." />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Language" />
                            <TextBox Text="{Binding LanguageCode}" Width="100" />
                            <TextBlock Text="BCP-47 code such as en-US; leave empty to auto-detect (recommended)" Opacity="0.75" FontSize="12"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Vocabulary" VerticalAlignment="Top" Margin="0,6,12,0"
                                       ToolTip="Names, products and jargon, separated by commas. Biases recognition and is kept exact during cleanup." />
                            <TextBox Text="{Binding VocabularyText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                        </DockPanel>

                        <StackPanel Visibility="{Binding HasLastError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Last error" />
                            <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Rambler.Danger}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Cleanup ================= -->
            <TabItem Header="Cleanup">
                <Grid Margin="4,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Style="{StaticResource Row}" Margin="0,12,0,4">
                        <TextBlock Style="{StaticResource RowLabel}" Text="Model" />
                        <ComboBox ItemsSource="{Binding ThinkingLevels}" SelectedItem="{Binding SelectedThinkingLevel}" DockPanel.Dock="Right"
                                  Width="170" Margin="8,0,0,0"
                                  ToolTip="Thinking level. Minimal is fastest; if a model doesn't support a level, Rambler retries with the model default." />
                        <ComboBox IsEditable="True" ItemsSource="{Binding CleanupModelSuggestions}" Text="{Binding CleanupModel, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="Technical refinement" />
                        <TextBlock Text="{Binding TechnicalRefinement, StringFormat={}{0}%}" DockPanel.Dock="Right" Width="44"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding TechnicalRefinement}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Text="{Binding RefinementDescription}" />
                    <DockPanel Grid.Row="3" Margin="0,12,0,6">
                        <Button Content="Restore default" Command="{Binding RestoreDefaultPromptCommand}" DockPanel.Dock="Right" Padding="12,4" />
                        <TextBlock Text="System prompt" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTip="Sent as the system instruction. Your transcript is sent separately as the user message." />
                    </DockPanel>
                    <TextBox Grid.Row="4" Text="{Binding CleanupPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    <Expander Grid.Row="5" Header="Always added by Rambler (not editable)" Margin="0,8,0,0"
                              ToolTip="Formatting and progressive-dictation rules appended after your prompt on every request; your prompt is never overwritten.">
                        <TextBox Text="{Binding ManagedPromptText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="160" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </Expander>
                </Grid>
            </TabItem>

            <!-- ================= Privacy ================= -->
            <TabItem Header="Privacy">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="What leaves your computer" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            While you dictate, microphone audio is streamed to Google's Gemini API for transcription.
                            In Prompt Cleanup mode, the transcript is also sent to a Gemini text model.
                            If live transcription fails and fallback is on, the recorded audio is uploaded to the Gemini Files API,
                            transcribed, and the upload is deleted right after.
                        </TextBlock>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="What stays on your computer" />
                        <TextBlock TextWrapping="Wrap">
                            • The microphone is only open while the tray icon is red (listening).<LineBreak />
                            • Audio and transcripts are never saved to disk. The last result is kept in memory for "Copy last" until Rambler exits.<LineBreak />
                            • Your API key is stored in Windows Credential Manager.<LineBreak />
                            • The diagnostic log contains errors only, never transcripts or keys.
                        </TextBlock>
                        <TextBlock x:Name="LogPathText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource Rambler.Danger}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save" IsDefault="True" Click="OnSave" MinWidth="88" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" MinWidth="88" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
