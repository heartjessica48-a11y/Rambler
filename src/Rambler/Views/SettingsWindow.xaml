<Window x:Class="Rambler.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rambler Settings" Width="600" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Rambler.Danger}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <!-- ================= General ================= -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
                        <CheckBox Content="Start Rambler when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Dictation" />
                        <TextBlock Style="{StaticResource Label}" Text="Default mode" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="260" HorizontalAlignment="Left" />

                        <TextBlock Style="{StaticResource Label}" Text="Start / stop dictation (selected mode)" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyToggleBox" Text="{Binding HotkeyToggle, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                     VerticalContentAlignment="Center" />
                            <Button x:Name="RecordToggleButton" Content="Record" Click="OnRecordClick" Tag="{Binding ElementName=HotkeyToggleBox}"
                                    Margin="8,0,0,0" Padding="12,4" MinWidth="80" ToolTip="Press the keys you want to use" />
                            <Button Content="Clear" Click="OnClearClick" Tag="{Binding ElementName=HotkeyToggleBox}"
                                    Margin="6,0,0,0" Padding="12,4" ToolTip="Turn this shortcut off" />
                        </StackPanel>
                        <TextBlock Text="{Binding ToggleStatus}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToggleStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Rambler.Danger}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Label}" Text="Start / stop dictation (Smart Only bypass)" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyBypassBox" Text="{Binding HotkeyBypass, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                     VerticalContentAlignment="Center" />
                            <Button x:Name="RecordBypassButton" Content="Record" Click="OnRecordClick" Tag="{Binding ElementName=HotkeyBypassBox}"
                                    Margin="8,0,0,0" Padding="12,4" MinWidth="80" ToolTip="Press the keys you want to use" />
                            <Button Content="Clear" Click="OnClearClick" Tag="{Binding ElementName=HotkeyBypassBox}"
                                    Margin="6,0,0,0" Padding="12,4" ToolTip="Turn this shortcut off" />
                        </StackPanel>
                        <TextBlock Text="{Binding BypassStatus}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BypassStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Rambler.Danger}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,6"
                                   Text="Click Record, then press the keys (Esc cancels). Both shortcuts are optional: clear one to turn it off. The bypass uses Smart Only for that dictation without changing your default mode." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="When to insert" />
                        <RadioButton GroupName="InsertTiming" Content="As I speak (progressive)" IsChecked="{Binding InsertProgressively}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,6"
                                   Text="Finished phrases appear in your app while you keep talking. Insertion pauses if you switch to another app and resumes when you click back." />
                        <RadioButton GroupName="InsertTiming" Content="When I finish" IsChecked="{Binding InsertWhenFinished}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,6"
                                   Text="Everything is inserted at the end. Best when whole-dictation coherence matters more than seeing text right away." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Text insertion" />
                        <ComboBox ItemsSource="{Binding InsertionMethods}" SelectedItem="{Binding SelectedInsertionMethod}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Line breaks never press a bare Enter (which sends messages in chat apps), except in classic editors like Notepad. Elsewhere multi-line text is pasted." />
                        <CheckBox Content="Restore my clipboard after pasting (when possible)" IsChecked="{Binding RestoreClipboard}" Margin="0,8,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
                        <TextBlock Style="{StaticResource Label}" Text="Theme" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="260" HorizontalAlignment="Left" />
                        <CheckBox Content="Play a short sound when dictation starts and stops" IsChecked="{Binding PlaySounds}" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Audio ================= -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Microphone" />
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="If the selected microphone is unplugged, Rambler uses the Windows default microphone." />

                        <TextBlock Style="{StaticResource Label}" Text="Input level" />
                        <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding MicLevel, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Test microphone" Command="{Binding TestMicrophoneCommand}" Padding="12,4" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding MicTestStatus}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The test records about 4 seconds and plays it back. Nothing is saved or sent anywhere." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="End of speech" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Rambler never ends a thought just because you pause: dictation continues until you stop it. Optional automatic stop:" />
                        <CheckBox Content="Stop automatically after a long silence" IsChecked="{Binding AutoStopOnSilence}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Silence before stopping (seconds):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding SilenceTimeoutSeconds}" Width="70" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Maximum dictation length (minutes):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding MaxRecordingMinutes}" Width="70" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Gemini ================= -->
            <TabItem Header="Gemini">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="API key" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ApiKeyStatus}" />
                        <PasswordBox x:Name="ApiKeyBox" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Create a key in Google AI Studio. It is stored in Windows Credential Manager, never in plain text, and never logged." />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Test connection" Command="{Binding TestConnectionCommand}" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="Remove saved key" Command="{Binding RemoveApiKeyCommand}" Padding="12,4" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ConnectionStatus}" Margin="0,8,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Transcription" />
                        <TextBlock Style="{StaticResource Label}" Text="Live transcription model" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding LiveModelSuggestions}"
                                  Text="{Binding LiveModel, UpdateSourceTrigger=LostFocus}" />
                        <CheckBox Content="If live transcription fails, transcribe the recorded audio instead" IsChecked="{Binding UseRecordedFallback}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Label}" Text="Recorded-audio model" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding RecordedModelSuggestions}"
                                  Text="{Binding RecordedModel, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="With fallback on, audio for the current dictation is kept in memory until it finishes, then cleared. It's never written to disk." />

                        <TextBlock Style="{StaticResource Label}" Text="Language (BCP-47, e.g. en-US)" />
                        <TextBox Text="{Binding LanguageCode}" Width="160" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Text="Leave empty for automatic detection (recommended)." />

                        <TextBlock Style="{StaticResource Label}" Text="Custom vocabulary" />
                        <TextBox Text="{Binding VocabularyText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Names, products and jargon, separated by commas. Used to bias recognition and kept exact during cleanup." />

                        <StackPanel Visibility="{Binding HasLastError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Last error" />
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding LastError}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Cleanup ================= -->
            <TabItem Header="Cleanup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Cleanup model" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding CleanupModelSuggestions}"
                                  Text="{Binding CleanupModel, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource Label}" Text="Thinking level" />
                        <ComboBox ItemsSource="{Binding ThinkingLevels}" SelectedItem="{Binding SelectedThinkingLevel}" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Minimal is fastest. If a model doesn't support the chosen level, Rambler retries with the model default." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Technical refinement" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding TechnicalRefinement}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TechnicalRefinement, StringFormat={}{0}%}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding RefinementDescription}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="System prompt" />
                        <TextBox Text="{Binding CleanupPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="260"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Restore default" Command="{Binding RestoreDefaultPromptCommand}" Padding="12,4" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Sent as the system instruction. Your transcript is sent separately as the user message." />
                        <Expander Header="Always added by Rambler (not editable)" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="These formatting and progressive-dictation rules are appended after your prompt on every request, so your text above is never overwritten." />
                                <TextBox Text="{Binding ManagedPromptText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Height="200" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Privacy ================= -->
            <TabItem Header="Privacy">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="What leaves your computer" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            While you dictate, microphone audio is streamed to Google's Gemini API for transcription.
                            In Prompt Cleanup mode, the finished transcript is also sent to a Gemini text model.
                            If live transcription fails and fallback is on, the recorded audio is uploaded to the Gemini Files API,
                            transcribed, and the upload is deleted right after.
                        </TextBlock>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="What stays on your computer" />
                        <TextBlock TextWrapping="Wrap">
                            • The microphone is only open while the tray icon is red (listening).<LineBreak />
                            • Audio and transcripts are never saved to disk. The last result is kept in memory for "Copy last" until Rambler exits.<LineBreak />
                            • Your API key is stored in Windows Credential Manager.<LineBreak />
                            • The diagnostic log contains errors only, never transcripts or keys.
                        </TextBlock>
                        <TextBlock x:Name="LogPathText" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource Rambler.Danger}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save" IsDefault="True" Click="OnSave" MinWidth="88" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" MinWidth="88" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
