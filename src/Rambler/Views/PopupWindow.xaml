<Window x:Class="Rambler.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rambler" Width="352" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Rambler.Text}">

    <Border Margin="12" CornerRadius="10" Padding="16,12,16,14"
            Background="{DynamicResource Rambler.PopupBackground}"
            BorderBrush="{DynamicResource Rambler.PopupBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- Header: status dot, title, status, settings -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Rambler.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Rambler.Listening}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Rambler.Busy}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Rambler.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="Rambler" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Margin="8,0"
                           Foreground="{DynamicResource Rambler.SubtleText}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Style="{StaticResource Rambler.IconButton}" Content="&#xE713;"
                        Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings" />
            </Grid>

            <!-- First-run hint -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource Rambler.Surface}"
                    Visibility="{Binding NeedsApiKey, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" FontSize="12">
                    Add your Gemini API key in Settings to start dictating.
                </TextBlock>
            </Border>

            <!-- Mode: segmented control -->
            <Border Margin="0,12,0,0" Padding="3" CornerRadius="8" Background="{DynamicResource Rambler.SegmentBackground}">
                <UniformGrid Columns="2">
                    <RadioButton Style="{StaticResource Rambler.SegmentButton}" Content="Prompt Cleanup"
                                 IsChecked="{Binding IsCleanupMode}"
                                 ToolTip="Transcribe, then clean up into a clear prompt with a Gemini Flash model" />
                    <RadioButton Style="{StaticResource Rambler.SegmentButton}" Content="Smart Only"
                                 IsChecked="{Binding IsSmartMode}"
                                 ToolTip="Insert Gemini's SMART transcript directly, no second model" />
                </UniformGrid>
            </Border>

            <!-- Primary control -->
            <Grid Margin="0,16,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <Button x:Name="MicButton" Style="{StaticResource Rambler.MicButton}" Command="{Binding ToggleCommand}"
                            AutomationProperties.Name="{Binding MicButtonText}" ToolTip="Start or stop dictation" />
                    <TextBlock Text="{Binding MicButtonText}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource Rambler.SubtleText}" />
                </StackPanel>
                <Button Style="{StaticResource Rambler.IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,16,0,0" Command="{Binding CancelCommand}"
                        ToolTip="Cancel and discard" AutomationProperties.Name="Cancel"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Input level -->
            <Grid Height="4" Margin="48,10,48,0" Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{DynamicResource Rambler.MeterTrack}" CornerRadius="2" />
                <Border Background="{DynamicResource Rambler.Listening}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Level}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <TextBlock Text="{Binding TargetText}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Rambler.SubtleText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Live preview -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" MaxHeight="150"
                    Background="{DynamicResource Rambler.Surface}"
                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="13" />
                </ScrollViewer>
            </Border>

            <!-- Message / pending result -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Rambler.Surface}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Rambler.DangerSurface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                    <WrapPanel Margin="-8,6,0,0">
                        <Button Style="{StaticResource Rambler.TextButton}" Content="Insert" Command="{Binding InsertPendingCommand}"
                                Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Rambler.TextButton}" Content="Copy" Command="{Binding CopyPendingCommand}"
                                Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Rambler.TextButton}" Content="Dismiss" Command="{Binding DismissCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Footer: hotkeys -->
            <Grid Margin="0,12,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Rambler.SubtleText}">
                        <Run Text="{Binding HotkeyText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  dictate" />
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource Rambler.SubtleText}" Margin="0,2,0,0">
                        <Run Text="{Binding BypassHotkeyText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  Smart Only" />
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource Rambler.TextButton}" Content="Copy last" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0" Command="{Binding CopyLastCommand}"
                        ToolTip="Copy the most recent result (kept in memory only)"
                        Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
