<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rambler palette (Dark). Standard controls use WPF's Fluent theme. -->
    <Color x:Key="Rambler.PopupBackgroundColor">#202124</Color>
    <SolidColorBrush x:Key="Rambler.PopupBackground" Color="#202124" />
    <Color x:Key="Rambler.PopupBorderColor">#33FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.PopupBorder" Color="#33FFFFFF" />
    <Color x:Key="Rambler.TextColor">#ECEDEF</Color>
    <SolidColorBrush x:Key="Rambler.Text" Color="#ECEDEF" />
    <Color x:Key="Rambler.SubtleTextColor">#A0A4AB</Color>
    <SolidColorBrush x:Key="Rambler.SubtleText" Color="#A0A4AB" />
    <Color x:Key="Rambler.SurfaceColor">#2A2B2F</Color>
    <SolidColorBrush x:Key="Rambler.Surface" Color="#2A2B2F" />
    <Color x:Key="Rambler.SegmentBackgroundColor">#2E3034</Color>
    <SolidColorBrush x:Key="Rambler.SegmentBackground" Color="#2E3034" />
    <Color x:Key="Rambler.SegmentSelectedColor">#45474D</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelected" Color="#45474D" />
    <Color x:Key="Rambler.SegmentSelectedTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelectedText" Color="#FFFFFF" />
    <Color x:Key="Rambler.HoverColor">#1FFFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.Hover" Color="#1FFFFFFF" />
    <Color x:Key="Rambler.AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="Rambler.Accent" Color="#3B82F6" />
    <Color x:Key="Rambler.AccentTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.AccentText" Color="#FFFFFF" />
    <Color x:Key="Rambler.ListeningColor">#EF4444</Color>
    <SolidColorBrush x:Key="Rambler.Listening" Color="#EF4444" />
    <Color x:Key="Rambler.BusyColor">#F59E0B</Color>
    <SolidColorBrush x:Key="Rambler.Busy" Color="#F59E0B" />
    <Color x:Key="Rambler.DangerColor">#FCA5A5</Color>
    <SolidColorBrush x:Key="Rambler.Danger" Color="#FCA5A5" />
    <Color x:Key="Rambler.DangerSurfaceColor">#3A2224</Color>
    <SolidColorBrush x:Key="Rambler.DangerSurface" Color="#3A2224" />
    <Color x:Key="Rambler.MeterTrackColor">#3A3C41</Color>
    <SolidColorBrush x:Key="Rambler.MeterTrack" Color="#3A3C41" />
    <Color x:Key="Rambler.ShadowColor">#99000000</Color>
    <SolidColorBrush x:Key="Rambler.Shadow" Color="#99000000" />
</ResourceDictionary>
