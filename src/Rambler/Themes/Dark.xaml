<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rambler palette (Dark): Windows 11 neutral surfaces + the user's Windows accent color.
         Standard controls (Settings) use WPF's Fluent theme, which follows the same accent. -->
    <SolidColorBrush x:Key="Rambler.Accent" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}" />
    <Color x:Key="Rambler.PopupBackgroundColor">#202020</Color>
    <SolidColorBrush x:Key="Rambler.PopupBackground" Color="#202020" />
    <Color x:Key="Rambler.PopupBorderColor">#33FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.PopupBorder" Color="#33FFFFFF" />
    <Color x:Key="Rambler.TextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.Text" Color="#FFFFFF" />
    <Color x:Key="Rambler.SubtleTextColor">#C8C8C8</Color>
    <SolidColorBrush x:Key="Rambler.SubtleText" Color="#C8C8C8" />
    <Color x:Key="Rambler.SurfaceColor">#2D2D2D</Color>
    <SolidColorBrush x:Key="Rambler.Surface" Color="#2D2D2D" />
    <Color x:Key="Rambler.SegmentBackgroundColor">#2D2D2D</Color>
    <SolidColorBrush x:Key="Rambler.SegmentBackground" Color="#2D2D2D" />
    <Color x:Key="Rambler.SegmentSelectedColor">#464646</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelected" Color="#464646" />
    <Color x:Key="Rambler.SegmentSelectedTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelectedText" Color="#FFFFFF" />
    <Color x:Key="Rambler.HoverColor">#15FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.Hover" Color="#15FFFFFF" />
    <Color x:Key="Rambler.AccentTextColor">#000000</Color>
    <SolidColorBrush x:Key="Rambler.AccentText" Color="#000000" />
    <Color x:Key="Rambler.ListeningColor">#FF6B6B</Color>
    <SolidColorBrush x:Key="Rambler.Listening" Color="#FF6B6B" />
    <Color x:Key="Rambler.BusyColor">#FCE100</Color>
    <SolidColorBrush x:Key="Rambler.Busy" Color="#FCE100" />
    <Color x:Key="Rambler.DangerColor">#FF99A4</Color>
    <SolidColorBrush x:Key="Rambler.Danger" Color="#FF99A4" />
    <Color x:Key="Rambler.DangerSurfaceColor">#442726</Color>
    <SolidColorBrush x:Key="Rambler.DangerSurface" Color="#442726" />
    <Color x:Key="Rambler.MeterTrackColor">#3D3D3D</Color>
    <SolidColorBrush x:Key="Rambler.MeterTrack" Color="#3D3D3D" />
    <Color x:Key="Rambler.ShadowColor">#99000000</Color>
    <SolidColorBrush x:Key="Rambler.Shadow" Color="#99000000" />
</ResourceDictionary>
