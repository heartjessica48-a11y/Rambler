<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rambler palette (Light). Standard controls use WPF's Fluent theme. -->
    <Color x:Key="Rambler.PopupBackgroundColor">#FBFBFD</Color>
    <SolidColorBrush x:Key="Rambler.PopupBackground" Color="#FBFBFD" />
    <Color x:Key="Rambler.PopupBorderColor">#1F000000</Color>
    <SolidColorBrush x:Key="Rambler.PopupBorder" Color="#1F000000" />
    <Color x:Key="Rambler.TextColor">#1B1B1F</Color>
    <SolidColorBrush x:Key="Rambler.Text" Color="#1B1B1F" />
    <Color x:Key="Rambler.SubtleTextColor">#5F6368</Color>
    <SolidColorBrush x:Key="Rambler.SubtleText" Color="#5F6368" />
    <Color x:Key="Rambler.SurfaceColor">#F1F2F5</Color>
    <SolidColorBrush x:Key="Rambler.Surface" Color="#F1F2F5" />
    <Color x:Key="Rambler.SegmentBackgroundColor">#E8EAEE</Color>
    <SolidColorBrush x:Key="Rambler.SegmentBackground" Color="#E8EAEE" />
    <Color x:Key="Rambler.SegmentSelectedColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelected" Color="#FFFFFF" />
    <Color x:Key="Rambler.SegmentSelectedTextColor">#1B1B1F</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelectedText" Color="#1B1B1F" />
    <Color x:Key="Rambler.HoverColor">#14000000</Color>
    <SolidColorBrush x:Key="Rambler.Hover" Color="#14000000" />
    <Color x:Key="Rambler.AccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="Rambler.Accent" Color="#2563EB" />
    <Color x:Key="Rambler.AccentTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.AccentText" Color="#FFFFFF" />
    <Color x:Key="Rambler.ListeningColor">#DC2626</Color>
    <SolidColorBrush x:Key="Rambler.Listening" Color="#DC2626" />
    <Color x:Key="Rambler.BusyColor">#D97706</Color>
    <SolidColorBrush x:Key="Rambler.Busy" Color="#D97706" />
    <Color x:Key="Rambler.DangerColor">#B42318</Color>
    <SolidColorBrush x:Key="Rambler.Danger" Color="#B42318" />
    <Color x:Key="Rambler.DangerSurfaceColor">#FDECEA</Color>
    <SolidColorBrush x:Key="Rambler.DangerSurface" Color="#FDECEA" />
    <Color x:Key="Rambler.MeterTrackColor">#E3E5EA</Color>
    <SolidColorBrush x:Key="Rambler.MeterTrack" Color="#E3E5EA" />
    <Color x:Key="Rambler.ShadowColor">#40000000</Color>
    <SolidColorBrush x:Key="Rambler.Shadow" Color="#40000000" />
</ResourceDictionary>
