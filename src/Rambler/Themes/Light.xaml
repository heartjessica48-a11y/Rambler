<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rambler palette (Light): Windows 11 neutral surfaces + the user's Windows accent color.
         Standard controls (Settings) use WPF's Fluent theme, which follows the same accent. -->
    <SolidColorBrush x:Key="Rambler.Accent" Color="{DynamicResource {x:Static SystemColors.AccentColorDark1Key}}" />
    <Color x:Key="Rambler.PopupBackgroundColor">#F9F9F9</Color>
    <SolidColorBrush x:Key="Rambler.PopupBackground" Color="#F9F9F9" />
    <Color x:Key="Rambler.PopupBorderColor">#1F000000</Color>
    <SolidColorBrush x:Key="Rambler.PopupBorder" Color="#1F000000" />
    <Color x:Key="Rambler.TextColor">#1A1A1A</Color>
    <SolidColorBrush x:Key="Rambler.Text" Color="#1A1A1A" />
    <Color x:Key="Rambler.SubtleTextColor">#5C5C5C</Color>
    <SolidColorBrush x:Key="Rambler.SubtleText" Color="#5C5C5C" />
    <Color x:Key="Rambler.SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.Surface" Color="#FFFFFF" />
    <Color x:Key="Rambler.SegmentBackgroundColor">#EDEDED</Color>
    <SolidColorBrush x:Key="Rambler.SegmentBackground" Color="#EDEDED" />
    <Color x:Key="Rambler.SegmentSelectedColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelected" Color="#FFFFFF" />
    <Color x:Key="Rambler.SegmentSelectedTextColor">#1A1A1A</Color>
    <SolidColorBrush x:Key="Rambler.SegmentSelectedText" Color="#1A1A1A" />
    <Color x:Key="Rambler.HoverColor">#0F000000</Color>
    <SolidColorBrush x:Key="Rambler.Hover" Color="#0F000000" />
    <Color x:Key="Rambler.AccentTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Rambler.AccentText" Color="#FFFFFF" />
    <Color x:Key="Rambler.ListeningColor">#C42B1C</Color>
    <SolidColorBrush x:Key="Rambler.Listening" Color="#C42B1C" />
    <Color x:Key="Rambler.BusyColor">#9D5D00</Color>
    <SolidColorBrush x:Key="Rambler.Busy" Color="#9D5D00" />
    <Color x:Key="Rambler.DangerColor">#C42B1C</Color>
    <SolidColorBrush x:Key="Rambler.Danger" Color="#C42B1C" />
    <Color x:Key="Rambler.DangerSurfaceColor">#FDE7E9</Color>
    <SolidColorBrush x:Key="Rambler.DangerSurface" Color="#FDE7E9" />
    <Color x:Key="Rambler.MeterTrackColor">#E0E0E0</Color>
    <SolidColorBrush x:Key="Rambler.MeterTrack" Color="#E0E0E0" />
    <Color x:Key="Rambler.ShadowColor">#40000000</Color>
    <SolidColorBrush x:Key="Rambler.Shadow" Color="#40000000" />
</ResourceDictionary>
